<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Library Catalogue{% endblock %}</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
<header>
  <a class="brand" href="index.php">Library Catalogue</a>
  <nav>
    <a href="index.php">Browse</a>
    {% if user %}
      <a href="add.php">Add book</a>
      <form method="post" action="logout.php" class="inline">
        <input type="hidden" name="csrf" value="{{ csrf_token() }}">
        <button class="link">Log out ({{ user.username }})</button>
      </form>
    {% else %}
      <a href="login.php">Log in</a>
      <a href="register.php">Register</a>
    {% endif %}
  </nav>
</header>
<main>
  {% for f in flash %}<p class="flash {{ f.type }}">{{ f.msg }}</p>{% endfor %}
  {% block content %}{% endblock %}
</main>
<script src="assets/app.js"></script>
</body>
</html>
