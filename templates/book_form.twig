{% extends "base.twig" %}
{% block content %}
<h1>{{ mode == 'add' ? 'Add a book' : 'Edit book' }}</h1>
{% if errors %}<ul class="errors">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
<form method="post" class="stack" id="book-form">
  <input type="hidden" name="csrf" value="{{ csrf_token() }}">
  {% if mode == 'edit' %}<input type="hidden" name="id" id="book-id" value="{{ book.id }}">{% endif %}
  <label>Title <input name="title" value="{{ book.title }}" maxlength="200" required></label>
  <label>Author <input name="author" value="{{ book.author }}" maxlength="120" required></label>
  <label>Genre
    <select name="genre_id" required>
      <option value="">Choose…</option>
      {% for g in genres %}<option value="{{ g.id }}" {{ g.id == book.genre_id ? 'selected' }}>{{ g.name }}</option>{% endfor %}
    </select>
  </label>
  <label>Year <input type="number" name="year" value="{{ book.year }}" min="1000" max="2200" required></label>
  <label>ISBN (optional) <input name="isbn" id="isbn" value="{{ book.isbn }}" maxlength="17"></label>
  <span id="isbn-status" class="hint"></span>
  <label>Description <textarea name="description" rows="5" maxlength="2000">{{ book.description }}</textarea></label>
  <button class="btn">{{ mode == 'add' ? 'Add book' : 'Save changes' }}</button>
</form>
{% endblock %}
