{% extends "base.twig" %}
{% block content %}
<h1>Register</h1>
{% if errors %}<ul class="errors">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
<form method="post" class="stack">
  <input type="hidden" name="csrf" value="{{ csrf_token() }}">
  <label>Username <input name="username" value="{{ username }}" required maxlength="30"></label>
  <label>Password (min 8) <input type="password" name="password" required minlength="8"></label>
  <label>Confirm password <input type="password" name="password2" required></label>
  <button class="btn">Create account</button>
</form>
{% endblock %}
