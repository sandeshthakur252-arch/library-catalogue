{% extends "base.twig" %}
{% block title %}{{ book.title }}{% endblock %}
{% block content %}
<article class="card">
  <h1>{{ book.title }}</h1>
  <p><strong>Author:</strong> {{ book.author }}</p>
  <p><strong>Genre:</strong> {{ book.genre }} &nbsp; <strong>Year:</strong> {{ book.year }}</p>
  <p><strong>ISBN:</strong> {{ book.isbn ?: '—' }}</p>
  <p>{{ book.description ?: 'No description.' }}</p>
  {% if can_edit %}
  <div class="actions">
    <a class="btn" href="edit.php?id={{ book.id }}">Edit</a>
    <form method="post" action="delete.php" class="inline" data-confirm="Delete this book permanently?">
      <input type="hidden" name="csrf" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="{{ book.id }}">
      <button class="btn danger">Delete</button>
    </form>
  </div>
  {% endif %}
  <p><a href="index.php">&laquo; Back to list</a></p>
</article>
{% endblock %}
